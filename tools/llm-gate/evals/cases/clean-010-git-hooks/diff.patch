new file mode 100644
index 0000000..4338837
--- /dev/null
+++ b/lefthook.yml
@@ -0,0 +1,29 @@
+# Git hooks (installed by `just setup`). They are a convenience for fast feedback;
+# the CI gates are the enforcement (gate drill 1 proves it).
+pre-commit:
+  parallel: true
+  jobs:
+    - name: csharpier
+      glob: "*.cs"
+      run: dotnet csharpier format {staged_files}
+      stage_fixed: true
+    - name: ruff
+      root: tools/llm-gate/
+      glob: "*.py"
+      run: uv run ruff format {staged_files} && uv run ruff check --fix {staged_files}
+      stage_fixed: true
+    - name: workflows
+      glob: ".github/workflows/*.yml"
+      run: actionlint {staged_files}
+    - name: secrets
+      run: gitleaks git --pre-commit --staged --redact
+
+commit-msg:
+  jobs:
+    - name: conventional-commit
+      run: scripts/check-commit-msg.sh {1}
+
+pre-push:
+  jobs:
+    - name: tests
+      run: just test
diff --git a/scripts/check-commit-msg.sh b/scripts/check-commit-msg.sh
new file mode 100755
index 0000000..0e90938
--- /dev/null
+++ b/scripts/check-commit-msg.sh
@@ -0,0 +1,36 @@
+#!/usr/bin/env bash
+# Conventional Commit check for a commit message file (lefthook commit-msg: {1}) or, with
+# --title, for a single line (the PR title check in CI uses the same rule).
+# Usage: check-commit-msg.sh <message-file> | check-commit-msg.sh --title "<title>"
+set -euo pipefail
+
+types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'
+pattern="^($types)(\([a-z0-9._/-]+\))?!?: [^ ].*$"
+max_length=100
+
+if [[ ${1:-} == --title ]]; then
+    header=${2:?usage: check-commit-msg.sh --title "<title>"}
+else
+    header=$(head -n 1 "${1:?usage: check-commit-msg.sh <message-file>}")
+fi
+
+# Leave git's own messages alone: merges, reverts, and fixup!/squash! for later autosquash.
+if [[ $header =~ ^(Merge |Revert \"|fixup! |squash! |amend! ) ]]; then
+    exit 0
+fi
+
+if [[ ! $header =~ $pattern ]]; then
+    cat >&2 <<EOF
+Not a Conventional Commit: "$header"
+Expected: <type>[(scope)][!]: <description>
+  types: ${types//|/, }
+  e.g.   feat(api): add /api/leap endpoint
+         fix!: return 400 for reversed workday ranges
+EOF
+    exit 1
+fi
+
+if ((${#header} > max_length)); then
+    echo "Header is ${#header} characters; keep it at most $max_length." >&2
+    exit 1
+fi
