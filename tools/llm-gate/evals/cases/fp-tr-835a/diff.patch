diff --git a/deploy/policies/base/llm-review.yaml b/deploy/policies/base/llm-review.yaml
new file mode 100644
index 0000000..d5d4292
--- /dev/null
+++ b/deploy/policies/base/llm-review.yaml
@@ -0,0 +1,47 @@
+# The release's LLM-review attestation (ADR 0009) must be there. Audit for now; switch to Deny
+# after a few releases have carried it (docs/adr/0010-admission-control.md).
+apiVersion: policies.kyverno.io/v1
+kind: ImageValidatingPolicy
+metadata:
+  name: calendar-gates-llm-review
+spec:
+  validationActions: [Audit]
+  matchConstraints:
+    namespaceSelector:
+      matchLabels:
+        kubernetes.io/metadata.name: calendar-gates
+    resourceRules:
+      - apiGroups: [""]
+        apiVersions: [v1]
+        operations: [CREATE, UPDATE]
+        # The subresource is how `kubectl debug` adds an ephemeral container to a running pod.
+        resources: [pods, pods/ephemeralcontainers]
+  # A cold check fetches every attestation and the Sigstore trust root; 10 s (the default) isn't
+  # always enough. Results are cached for an hour.
+  webhookConfiguration:
+    timeoutSeconds: 30
+  matchImageReferences:
+    - glob: "ghcr.io/gergodrazsdik/calendar-gates*"
+  attestors:
+    - name: release
+      cosign:
+        keyless:
+          identities:
+            - issuer: https://token.actions.githubusercontent.com
+              # A regex can't be wrapped safely.
+              # yamllint disable-line rule:line-length
+              subjectRegExp: '^https://github\.com/gergodrazsdik/calendar-gates/\.github/workflows/release\.yml@refs/tags/v[0-9].*$'
+  attestations:
+    - name: llmreview
+      intoto:
+        type: https://github.com/gergodrazsdik/calendar-gates/attestations/llm-review/v1
+  # Every container kind, not only spec.containers: an unattested image must not slip in as an init
+  # or ephemeral container.
+  variables:
+    - name: allImages
+      expression: images.containers + images.initContainers + images.ephemeralContainers
+  validations:
+    - expression: >-
+        variables.allImages.map(image,
+          verifyAttestationSignatures(image, attestations.llmreview, [attestors.release])).all(e, e > 0)
+      message: the image has no LLM-review attestation signed by release.yml on a release tag
