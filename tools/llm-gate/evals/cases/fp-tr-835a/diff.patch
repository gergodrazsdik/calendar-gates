+    [ "$got" = "$want" ] || { echo "kyverno CLI $want needed, found ${got:-none}" >&2; exit 1; }
+    kubectl --context {{ kube_context }} kustomize deploy/policies > /dev/null
+    kyverno test deploy/policies/tests --remove-color
