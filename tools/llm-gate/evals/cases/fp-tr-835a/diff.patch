diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 95cf173..1e32b70 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -371,9 +371,118 @@ jobs:
             echo "- chart: \`$CHART_REPO/calendar-gates --version $VERSION\` (pinned to the digest)"
           } >> "$GITHUB_STEP_SUMMARY"
 
+  # Admission control (ADR 0010): Kyverno with the project's policies on a throwaway kind cluster.
+  # The release must be admitted in `calendar-gates`; the unattested edge image and a foreign image
+  # must be denied; `calendar-gates-dev` must admit edge and report it. The release only goes
+  # public (smoke) if the policies hold.
+  admission-smoke:
+    name: admission-smoke
+    needs: [verify, build, publish]
+    runs-on: ubuntu-24.04
+    timeout-minutes: 20
+    permissions:
+      contents: read
+    env:
+      VERSION: ${{ needs.verify.outputs.version }}
+      DIGEST: ${{ needs.build.outputs.digest }}
+      # Pinned so the test can't drift; it is only ever refused (a server-side dry run, never pulled).
+      FOREIGN: docker.io/library/busybox@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - uses: azure/setup-helm@9bc31f4ebc9c6b171d7bfbaa5d006ae7abdb4310 # v5.0.1
+        with:
+          version: v4.2.2
+      # The project cluster's definition (node image pinned by digest; Kubernetes 1.35 for Kyverno 1.19).
+      - uses: helm/kind-action@06c1ae10762d3b9c1644e7fe69596ae519e015a2 # v1.15.0
+        with:
+          version: v0.33.0
+          kubectl_version: v1.35.8
+          config: deploy/kind/cluster.yaml
+          cluster_name: calendar-gates
+      - name: Kyverno (chart pinned by sha256, images by digest)
+        run: |
+          file=$(awk '{print $2}' deploy/kyverno/chart.sha256)
+          version=${file#kyverno-}; version=${version%.tgz}
+          helm pull kyverno --repo https://kyverno.github.io/kyverno/ --version "$version" -d "$RUNNER_TEMP"
+          (cd "$RUNNER_TEMP" && sha256sum -c --quiet) < deploy/kyverno/chart.sha256
+          helm install kyverno "$RUNNER_TEMP/$file" -n kyverno --create-namespace \
+            -f deploy/kyverno/values.yaml --wait --timeout 5m
+      - name: Policies (both namespaces), ready
+        run: |
+          kubectl apply -k deploy/policies
+          for _ in $(seq 60); do
+            pending=$(kubectl get validatingpolicies,imagevalidatingpolicies -o json \
+              | jq '[.items[] | select(.status.conditionStatus.ready != true)] | length')
+            [ "$pending" = 0 ] && break
+            sleep 2
+          done
+          kubectl get validatingpolicies,imagevalidatingpolicies
+          [ "$pending" = 0 ] || { echo "::error::$pending policies are not ready"; exit 1; }
+      - name: The release is admitted in calendar-gates
+        run: |
+          helm install calendar-gates oci://ghcr.io/gergodrazsdik/charts/calendar-gates \
+            --version "$VERSION" -n calendar-gates --wait --timeout 4m
+          kubectl -n calendar-gates get pods -o wide
+          running=$(kubectl -n calendar-gates get pods -o jsonpath='{.items[*].spec.containers[*].image}')
+          for image in $running; do
+            [[ $image == *"@$DIGEST" ]] || { echo "::error::$image is not the release digest $DIGEST"; exit 1; }
+          done
+      - name: Unattested and foreign images are denied in calendar-gates
+        run: |
+          refused() { # pod name, image, the policy that must refuse it
+            if out=$(kubectl -n calendar-gates run "$1" --image="$2" --restart=Never --dry-run=server 2>&1); then
+              echo "::error::$2 was admitted in calendar-gates"; exit 1
+            fi
+            echo "$out"
+            grep -q "Policy $3 failed" <<< "$out" || { echo "::error::$2 was not refused by $3"; exit 1; }
+          }
+          refused edge "$IMAGE:edge" calendar-gates-release
+          refused foreign "$FOREIGN" calendar-gates-images
+          # An unattested image hidden in an init container, next to the attested release.
+          if out=$(kubectl create --dry-run=server -f - 2>&1 <<EOF
+          apiVersion: v1
+          kind: Pod
+          metadata: {name: init-edge, namespace: calendar-gates}
+          spec:
+            initContainers: [{name: sneak, image: "$IMAGE:edge"}]
+            containers: [{name: app, image: "$IMAGE@$DIGEST"}]
+          EOF
+          ); then
+            echo "::error::an edge init container was admitted in calendar-gates"; exit 1
+          fi
+          echo "$out"
+          grep -q "Policy calendar-gates-release failed" <<< "$out" \
+            || { echo "::error::the edge init container was not refused by calendar-gates-release"; exit 1; }
+      - name: calendar-gates-dev admits edge and reports it
+        run: |
+          kubectl -n calendar-gates-dev run edge --image="$IMAGE:edge" --restart=Never
+          for _ in $(seq 30); do
+            found=$(kubectl -n calendar-gates-dev get policyreports -o json | jq -r '[.items[]
+              | select(.scope.name == "edge") | .results[]?
+              | select(.policy == "calendar-gates-release-dev" and .result == "fail")] | length')
+            [ "${found:-0}" -gt 0 ] && break
+            sleep 2
+          done
+          [ "${found:-0}" -gt 0 ] || { echo "::error::no PolicyReport failure for edge in calendar-gates-dev"; exit 1; }
+          echo "calendar-gates-dev: edge admitted, reported as failing calendar-gates-release-dev"
+      - name: Explain a failure
+        if: failure()
+        run: |
+          {
+            echo "### admission-smoke diagnostics"
+            echo '```'
+            kubectl get validatingpolicies,imagevalidatingpolicies -o wide 2>&1 || true
+            kubectl get pods -A 2>&1 || true
+            kubectl -n calendar-gates get events --sort-by=.lastTimestamp 2>&1 | tail -n 30 || true
+            kubectl -n kyverno logs deploy/kyverno-admission-controller --tail=60 2>&1 || true
+            echo '```'
+          } >> "$GITHUB_STEP_SUMMARY"
+
   smoke:
     name: smoke
-    needs: [verify, build, publish]
+    needs: [verify, build, publish, admission-smoke]
     runs-on: ubuntu-24.04
     timeout-minutes: 10
     permissions:
