+# Kyverno for the project cluster (docs/adr/0010-admission-control.md), chart 3.9.1 = Kyverno
+# v1.19.1. Every image is pinned to a digest whose SLSA provenance was verified on 2026-10-17
+# (cosign verify-attestation --type slsaprovenance02: slsa-github-generator, built from
+# kyverno/kyverno at 40ec788d48, the v1.19.1 tag). The chart has no digest field, so the digest
+# rides on the tag: repo:v1.19.1@sha256:..., where the digest wins. Update all of them together,
+# with the chart version in the justfile, after verifying the new release the same way.
+admissionController:
+  rbac:
+    clusterRole:
+      extraResources:
+        - apiGroups: [""]
+          resources: [pods/ephemeralcontainers]
+          verbs: [get, list, watch]
+  initContainer:
+    image:
+      tag: v1.19.1@sha256:c25c47461f06f2845a48c319ae86fbbc1730a7b9ed5b701889c9dc1f9ee94b09
+  container:
+    image:
+      tag: v1.19.1@sha256:b31d8511ae5fd6010e2a01ea72ebae08eb82fa51d91af14a1d9fe989949b4edb
+backgroundController:
+  rbac:
+    clusterRole:
+      extraResources:
+        - apiGroups: [""]
+          resources: [pods/ephemeralcontainers]
+          verbs: [get, list, watch]
+  image:
+    tag: v1.19.1@sha256:8f1e9143373a27578cafc2d28d2c66ba0926c63b4c77e63de8d2fdd4a122859f
+cleanupController:
+  image:
+    tag: v1.19.1@sha256:67a48e62a8d8f8120c86914ff822b90017c54054c7b64ef8a1555645e9d9761e
+reportsController:
+  rbac:
+    clusterRole:
+      extraResources:
+        - apiGroups: [""]
+          resources: [pods/ephemeralcontainers]
+          verbs: [get, list, watch]
+  image:
+    tag: v1.19.1@sha256:c0eee97b9b44a0dd35805d56b358fa52548480f79d4944602b9609538eccd64c
+crds:
+  migration:
+    image:
+      tag: v1.19.1@sha256:ced7b2be0b04250cabfe695f15307f69eb715fe23234816388af4f3812915b2a
+webhooksCleanup:
+  image:
+    tag: v1.19.1@sha256:31bb42ce7f5b2e27c1cf633aeff4f0cad1f5bb63761e2cb09f0e25cdd26572bf
+test:
+  image:
+    tag: v1.19.1@sha256:31bb42ce7f5b2e27c1cf633aeff4f0cad1f5bb63761e2cb09f0e25cdd26572bf
