diff --git a/deploy/policies/base/release.yaml b/deploy/policies/base/release.yaml
new file mode 100644
index 0000000..d019d51
--- /dev/null
+++ b/deploy/policies/base/release.yaml
@@ -0,0 +1,65 @@
+# Release images only (docs/adr/0010-admission-control.md): build provenance and a vulnerability
+# scan without critical findings, both attested by release.yml on a v* tag (ADR 0009). CI already
+# fails a release on high findings; admission fails on critical: two layers, two thresholds.
+apiVersion: policies.kyverno.io/v1
+kind: ImageValidatingPolicy
+metadata:
+  name: calendar-gates-release
+spec:
+  validationActions: [Deny]
+  matchConstraints:
+    namespaceSelector:
+      matchLabels:
+        kubernetes.io/metadata.name: calendar-gates
+    resourceRules:
+      - apiGroups: [""]
+        apiVersions: [v1]
+        operations: [CREATE, UPDATE]
+        # The subresource is how `kubectl debug` adds an ephemeral container to a running pod.
+        resources: [pods, pods/ephemeralcontainers]
+  # A cold check fetches every attestation and the Sigstore trust root; 10 s (the default) isn't
+  # always enough. Results are cached for an hour.
+  webhookConfiguration:
+    timeoutSeconds: 30
+  matchImageReferences:
+    - glob: "ghcr.io/gergodrazsdik/calendar-gates*"
+  validationConfigurations:
+    mutateDigest: true # what runs is the digest that was verified
+    verifyDigest: true
+    required: true
+  attestors:
+    - name: release
+      cosign:
+        keyless:
+          identities:
+            - issuer: https://token.actions.githubusercontent.com
+              # A regex can't be wrapped safely.
+              # yamllint disable-line rule:line-length
+              subjectRegExp: '^https://github\.com/gergodrazsdik/calendar-gates/\.github/workflows/release\.yml@refs/tags/v[0-9].*$'
+  attestations:
+    - name: provenance
+      intoto:
+        type: https://slsa.dev/provenance/v1
+    - name: vulnscan
+      intoto:
+        type: https://github.com/gergodrazsdik/calendar-gates/attestations/vuln-scan/v1
+  # extractPayload() returns the in-toto statement of a GitHub attestation, so the predicate is under
+  # .predicate.
+  # Every container kind, not only spec.containers: an unattested image must not slip in as an init
+  # or ephemeral container.
+  variables:
+    - name: allImages
+      expression: images.containers + images.initContainers + images.ephemeralContainers
